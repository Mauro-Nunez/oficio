# Production environment configuration for oficiosgarupa.com.ar
APP_ENV=prod
APP_SECRET=change_this_to_a_random_string_in_production
APP_DEBUG=false

# Database configuration
DATABASE_URL="mysql://gustavo:prod_password_12345678@mysql:3306/gustavo?serverVersion=8.0&charset=utf8mb4"

# Mailer configuration (if needed)
# MAILER_DSN=smtp://localhost:1025

# Domain configuration
APP_DOMAIN=oficiosgarupa.com.ar
TRUSTED_HOSTS='^(www\.)?oficiosgarupa\.com\.ar$'

# SSL/HTTPS configuration
SECURE_SCHEME=https

# Session configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax