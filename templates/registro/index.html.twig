{% extends 'base.html.twig' %}

{% block title %}FORMULARIO DE REGISTRO{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <!-- Incluye Bootstrap CSS si no está ya incluido -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="shortcut icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
    <style>
        body {
            background: white;
            min-height: 100vh;
        }
        
        .registration-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem 0;
        }
        
        .logo-section {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .logo-section img {
            max-width: 500px;
            width: 100%;
            height: auto;
        }
        
        .registration-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            border: none;
        }
        
        .card-header-custom {
            background: linear-gradient(135deg, #001E5A 0%, #003d82 100%);
            color: white;
            padding: 2rem;
            text-align: center;
        }
        
        .card-header-custom h2 {
            margin: 0;
            font-weight: 600;
            font-size: 1.8rem;
            letter-spacing: 1px;
        }
        
        .form-section {
            padding: 2rem 3rem 3rem;
        }
        
        .form-group-custom {
            margin-bottom: 1.5rem;
        }
        
        .form-label-custom {
            font-weight: 600;
            color: #333;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .form-control-custom {
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            padding: 0.75rem 1rem;
            font-size: 1rem;
            transition: all 0.3s ease;
            background-color: #f8f9fa;
            color: #333 !important;
        }
        
        .form-control-custom:focus {
            border-color: #001E5A;
            box-shadow: 0 0 0 0.2rem rgba(0, 30, 90, 0.1);
            background-color: white;
            color: #333 !important;
        }
        
        .form-control-custom::placeholder {
            color: #999;
            font-size: 0.9rem;
        }
        
        /* Specific styles for select elements */
        select.form-control-custom {
            color: #333 !important;
            font-size: 1rem !important;
            height: auto !important;
            padding: 0.75rem 2.5rem 0.75rem 1rem !important;
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 1rem center;
            background-size: 1em;
        }
        
        select.form-control-custom option {
            color: #333 !important;
            background-color: white;
            font-size: 1rem !important;
            padding: 0.5rem !important;
        }
        
        .btn-primary-custom {
            background: linear-gradient(135deg, #001E5A 0%, #003d82 100%);
            border: none;
            border-radius: 10px;
            padding: 1rem 2rem;
            font-size: 1.1rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(0, 30, 90, 0.3);
            color: white !important;
        }
        
        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 20px rgba(0, 30, 90, 0.4);
            background: linear-gradient(135deg, #003d82 0%, #001E5A 100%);
            color: white !important;
        }
        
        .btn-secondary-custom {
            background: transparent;
            border: 2px solid #001E5A;
            color: #001E5A;
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-secondary-custom:hover {
            background-color: #001E5A;
            color: white;
            transform: translateY(-2px);
        }
        
        .btn-back {
            background: #6c757d;
            border: none;
            border-radius: 10px;
            padding: 0.75rem 2rem;
            color: white;
            font-weight: 600;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }
        
        .btn-back:hover {
            background: #5a6268;
            transform: translateY(-2px);
            text-decoration: none;
            color: white;
        }
        
        .form-section-divider {
            border-top: 2px solid #e0e0e0;
            margin: 2rem -3rem;
            padding-top: 2rem;
        }
        
        .form-check-custom {
            padding: 0.5rem 1rem;
            background-color: #f8f9fa;
            border-radius: 10px;
            margin-right: 1rem;
            transition: all 0.3s ease;
        }
        
        .form-check-custom:hover {
            background-color: #e9ecef;
        }
        
        .form-check-custom .form-check-input {
            margin-top: 0.3rem;
        }
        
        .modal-content {
            border-radius: 15px;
            border: none;
        }
        
        .modal-header {
            background: linear-gradient(135deg, #001E5A 0%, #003d82 100%);
            color: white;
            border-radius: 15px 15px 0 0;
            border: none;
        }
        
        .modal-header .close {
            color: white;
            opacity: 0.8;
        }
        
        .modal-header .close:hover {
            opacity: 1;
        }
        
        @media (max-width: 768px) {
            .form-section {
                padding: 1.5rem;
            }
            
            .card-header-custom h2 {
                font-size: 1.5rem;
            }
            
            .registration-container {
                padding: 1rem;
            }
        }
    </style>
{% endblock %}
{% block body %}
<div class="registration-container">
    <div class="logo-section">
        <img src="{{ asset('images/frame11-cropped.svg') }}" alt="Logo">
    </div>
    
    <div class="registration-card">
        <div class="card-header-custom">
            <h2>FORMULARIO DE REGISTRO</h2>
        </div>
        
        <div class="form-section">

            {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

            <div class="form-group-custom">
                {{ form_label(form.name, 'NOMBRE Y APELLIDO', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.name, {'attr': {'class': 'form-control form-control-custom', 'placeholder': 'INGRESE SU NOMBRE Y APELLIDO'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.name) }}
                </div>
            </div>

            <div class="form-group-custom">
                {{ form_label(form.email, 'CORREO ELECTRÓNICO', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control form-control-custom', 'placeholder': 'INGRESE SU CORREO'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.email) }}
                </div>
            </div>          
            <div class="form-group-custom">
                {{ form_label(form.date, 'FECHA DE NACIMIENTO Ej: 01-01-2000', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.date, {'attr': {'class': 'form-control form-control-custom date-input', 'placeholder': 'DD-MM-AAAA'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.date) }}
                </div>
            </div>
            <div class="form-group-custom">
                {{ form_label(form.description, 'DESCRIPCIÓN', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control form-control-custom', 'placeholder': 'DESCRIPCIÓN DE SU ACTIVIDAD LABORAL', 'rows': '3'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.description) }}
                </div>
            </div>
            <div class="form-group-custom">
                {{ form_label(form.phone, 'TELÉFONO', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.phone, {'attr': {'class': 'form-control form-control-custom', 'placeholder': 'TELÉFONO'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.phone) }}
                </div>
            </div>
            <div class="form-group-custom">
                {{ form_label(form.dni, 'DNI', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.dni, {'attr': {'class': 'form-control form-control-custom', 'placeholder': 'DNI'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.dni) }}
                </div>
            </div>
            <div class="form-group-custom">
                {{ form_label(form.address, 'DIRECCIÓN', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.address, {'attr': {'class': 'form-control form-control-custom', 'placeholder': 'DIRECCIÓN'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.address) }}
                </div>
            </div>
                        
            <div class="form-section-divider"></div>
            
            <div class="form-group-custom">
                {{ form_label(form.oficio, 'OFICIO', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.oficio, {'attr': {'class': 'form-control form-control-custom', 'placeholder': '-- SELECCIONAR UN OFICIO --', 'style': 'text-transform: uppercase'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.oficio) }}
                </div>
            </div>

            <div class="form-group-custom">
                <button type="button" class="btn btn-secondary-custom w-100" data-toggle="modal" data-target="#recomendacionModal">
                    ¿TU OFICIO NO ESTÁ EN LA LISTA?
                </button>
            </div>

            <!-- Modal -->
            <div class="form-group-custom">
                {{ form_label(form.workAddress, 'DIRECCIÓN DE TRABAJO (OPCIONAL)', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.workAddress, {'attr': {'class': 'form-control form-control-custom', 'placeholder': 'DIRECCIÓN DE TRABAJO'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.workAddress) }}
                </div>
            </div>
            <div class="form-group-custom">
                {{ form_label(form.payment, 'TIPO DE PAGO', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.payment, {'attr': {'class': 'form-control form-control-custom', 'placeholder': 'TIPO DE PAGO'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.payment) }}
                </div>
            </div>
            <div class="form-group-custom">
                {{ form_label(form.time, 'HORARIO DE TRABAJO', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.time, {'attr': {'class': 'form-control form-control-custom', 'placeholder': 'HORARIO DE TRABAJO'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.time) }}
                </div>
            </div>
            <div class="form-section-divider"></div>
            
            <div class="form-group-custom">
                {{ form_label(form.certification, '¿POSEE CERTIFICACIÓN?', {'label_attr': {'class': 'form-label-custom mb-3'}}) }}
                
                <div class="d-flex">
                    <div class="form-check form-check-custom">
                        {{ form_widget(form.certification.0, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.certification.0, 'SÍ', {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>

                    <div class="form-check form-check-custom">
                        {{ form_widget(form.certification.1, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.certification.1, 'NO', {'label_attr': {'class': 'form-check-label'}}) }}
                    </div>
                </div>
                
                <div class="invalid-feedback">
                    {{ form_errors(form.certification) }}
                </div>
            </div>
            <div class="form-group-custom">
                {{ form_label(form.institution, 'INSTITUCIÓN', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.institution, {'attr': {'class': 'form-control form-control-custom', 'placeholder': 'INSTITUCIÓN CERTIFICANTE'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.institution) }}
                </div>
            </div>
            <div class="form-group-custom">
                {{ form_label(form.recomendation, 'REFERENCIA LABORAL', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.recomendation, {'attr':{'class': 'form-control form-control-custom text-uppercase', 'placeholder': 'POSEE ALGUNA REFERENCIA LABORAL'}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.recomendation) }}
                </div>
            </div>
            <div class="form-group-custom">
                {{ form_label(form.imageFile, 'IMAGEN/LOGO (OPCIONAL)', {'label_attr': {'class': 'form-label-custom'}}) }}
                {{ form_widget(form.imageFile, {'attr': {'class': 'form-control form-control-custom', 'placeholder': 'Seleccionar Imagen/Logo', 'required': false}}) }}
                <div class="invalid-feedback">
                    {{ form_errors(form.imageFile) }}
                </div>
            </div>
            <div class="form-section-divider"></div>
            
            <div class="d-grid gap-3">
                <button type="submit" class="btn btn-primary-custom">REGISTRARSE</button>
                <a href="{{ path('app_home') }}" class="btn btn-back text-center">VOLVER AL INICIO</a>
            </div>
            
            {{ form_end(form) }}

        </div>
                    <div class="modal fade" id="recomendacionModal" tabindex="-1" role="dialog" aria-labelledby="recomendacionModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="recomendacionModalLabel">SOLICITUD DE OFICIO</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form id="recomendacionForm" method="POST" action="{{ path('crear_recomendacion') }}">
                                <div class="form-group">
                                    <label for="recomendacionText">POR FAVOR INGRESE UNA DESCRIPCIÓN DEL OFICIO QUE DESEA SOLICITAR (LA SOLICITUD ESTÁ SUJETA A APROBACIÓN)</label>
                                    <input type="text" class="form-control" id="recomendacionText" name="recomendacionText" required>
                                </div>
                                <!-- Puedes añadir más campos si es necesario -->
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">CERRAR</button>
                            <button type="submit" form="recomendacionForm" class="btn btn-primary">ENVIAR</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.date-input').on('input', function(e) {
                let value = $(this).val().replace(/[^0-9]/g, ''); // Remueve todo lo que no sea número
                if (value.length > 2 && value.length <= 4) {
                    value = value.replace(/(\d{2})(\d+)/, '$1-$2');
                } else if (value.length > 4) {
                    value = value.replace(/(\d{2})(\d{2})(\d+)/, '$1-$2-$3');
                }
                $(this).val(value);
            });
        });
    </script>
    <!-- Incluye jQuery y Bootstrap JS si no están ya incluidos -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>


{% endblock %}
